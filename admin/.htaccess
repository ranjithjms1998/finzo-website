# Deny direct web access to everything in the CodeIgniter project root
# (.env, composer.json/lock, app/, writable/, vendor/, spark, etc.). Only
# admin/public/ — which re-grants access via its own .htaccess — should
# ever be reachable directly; index.php there is the sole entry point.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
